generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Utilisé pour les migrations
}

model Universite {
  id        Int         @id @default(autoincrement())
  nom       String
  facultes  Faculte[]
  utilisateurs Utilisateur[] // tous les utilisateurs liés à l'université
}

model Faculte {
  id            Int         @id @default(autoincrement())
  nom           String
  universiteId  Int
  universite    Universite   @relation(fields: [universiteId], references: [id])
  filieres      Filiere[]
}

model Filiere {
  id         Int       @id @default(autoincrement())
  nom        String
  faculteId  Int
  faculte    Faculte   @relation(fields: [faculteId], references: [id])
  niveaux    Niveau[]
}

model Niveau {
  id         Int        @id @default(autoincrement())
  nom        String
  filiereId  Int
  filiere    Filiere    @relation(fields: [filiereId], references: [id])
  semestres  Semestre[]
  modules    Module[]
  etudiants  Utilisateur[] @relation("EtudiantNiveau")
}

model Semestre {
  id        Int     @id @default(autoincrement())
  nom       String
  niveauId  Int
  niveau    Niveau  @relation(fields: [niveauId], references: [id])
  ues       UE[]
}

model UE {
  id         Int      @id @default(autoincrement())
  code       String
  intitule   String
  semestreId Int
  semestre   Semestre @relation(fields: [semestreId], references: [id])
  modules    Module[]
}

model Module {
  id         Int       @id @default(autoincrement())
  nom        String
  niveauId   Int
  niveau     Niveau    @relation(fields: [niveauId], references: [id])
  credit     Int
  ueId       Int
  ue         UE        @relation(fields: [ueId], references: [id])
  notes      Note[]
  professeurs Utilisateur[] @relation("ProfesseurModule")
}

model Note {
  id         Int         @id @default(autoincrement())
  valeur     Float
  etudiantId String
  moduleId   Int
  etudiant   Utilisateur @relation("EtudiantNotes", fields: [etudiantId], references: [id])
  module     Module      @relation(fields: [moduleId], references: [id])

  @@unique([etudiantId, moduleId])
}

model SemestreNote {
  id         Int    @id @default(autoincrement())
  etudiantId String
  semestreId Int
  note       Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([etudiantId, semestreId])
}

model Utilisateur {
  id           String      @id @default(uuid())
  nom          String
  email        String      @unique
  code         String?     @unique
  motDePasse   String
  role         Role
  universiteId Int?
  universite   Universite? @relation(fields: [universiteId], references: [id])

  // Relation si c'est un étudiant
  niveauId     Int?
  niveau       Niveau?     @relation("EtudiantNiveau", fields: [niveauId], references: [id])
  notes        Note[]      @relation("EtudiantNotes")

  // Relation si c'est un professeur
  modules      Module[]    @relation("ProfesseurModule")

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  PROFESSEUR
  ETUDIANT
}
